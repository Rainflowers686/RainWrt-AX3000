+/* offset calculation that does not use multiplication */
+static INLINE UINT32 CalculateFBROffset(UCHAR FuncNo) {
+    UCHAR i = FuncNo;
+    UINT32 offset = 0;
+    while (i) {
+        offset += 0x100;
+        i--;
+    }
+    return offset;
