+static void fimc_config(camif_cfg_t *cfg,u32 x, u32 y, int bpp)
+{
+	cfg->target_x = x;
+	cfg->target_y = y;
+
+	switch (bpp) {
+	case 16:
+		cfg->fmt = CAMIF_RGB16;
+		break;
+	case 24:
+		cfg->fmt = CAMIF_RGB24;
+		break;
+	case 420:
+		cfg->fmt = CAMIF_IN_YCBCR422|CAMIF_OUT_YCBCR420; 
+		break;
+	case 422:
+		cfg->fmt = CAMIF_IN_YCBCR422|CAMIF_OUT_YCBCR422; 
+		break;
+	default: 
+		panic("Wrong BPP \n");
+	}
+}
