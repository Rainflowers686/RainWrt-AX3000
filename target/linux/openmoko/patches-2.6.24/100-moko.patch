+camif_cfg_t * get_camif(int nr)
+{
+	camif_cfg_t *ret = NULL;
+	switch(nr) {
+	case CODEC_MINOR:
+		ret = &fimc[0];
+		break;
+	case PREVIEW_MINOR:
+		ret = &fimc[1];
+		break;
+	default:
+		panic("Unknow Minor Number \n");
+	}
+	return ret;
+}
