===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ linux-2.6.24.7/drivers/sdio/function/wlan/ar6000/htc/htc_services.c	2008-12-11 22:46:49.000000000 +0100
@@ -0,0 +1,403 @@
