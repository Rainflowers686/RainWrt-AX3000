+++ linux-2.6.24.7/drivers/power/bq27000_battery.c	2008-12-11 22:46:49.000000000 +0100
@@ -0,0 +1,424 @@
+/*
+ * Driver for batteries with bq27000 chips inside via HDQ
+ *
+ * Copyright 2008 Openmoko, Inc
