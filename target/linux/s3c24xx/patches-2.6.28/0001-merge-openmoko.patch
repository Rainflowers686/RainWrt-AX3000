+++ linux-2.6.28/drivers/regulator/pcf50633-regulator.c	2009-01-02 00:01:56.000000000 +0100
@@ -0,0 +1,330 @@
+/* Philips PCF50633 PMIC Driver
+ *
+ * (C) 2006-2008 by Openmoko, Inc.
+ * Author: Balaji Rao <balajirrao@openmoko.org>
+ * All rights reserved.
+ *
