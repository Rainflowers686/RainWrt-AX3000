--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ linux-2.6.28/include/linux/android_alarm.h	2009-01-02 00:01:57.000000000 +0100
@@ -0,0 +1,59 @@
+/* include/linux/android_alarm.h
+ *
