+	select S3C_DEV_HSMMC1
+	select S3C_DEV_I2C1
+	select S3C6410_SETUP_SDHCI
+	select S3C64XX_SETUP_I2C1
+	select S3C_DEV_FB
+	select S3C64XX_SETUP_FB_24BPP
+#	select SENSORS_PCF50633
+	select POWER_SUPPLY
+#	select GTA02_HDQ
+	select MACH_NEO1973
+	help
+          Machine support for the Openmoko GTA03 Phone
+
