+++ linux-2.6.28/arch/arm/mach-s3c2440/camera/imgsensor.c	2009-01-02 00:01:56.000000000 +0100
@@ -0,0 +1,250 @@
+/*
+ *  Copyright (C) 2004 Samsung Electronics 
+ *             SW.LEE <hitchcar@samsung.com>
+ *
+ *  Copyright (C) 2000 Russell King : pcf8583.c
+ *
