--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ linux-2.6.28/drivers/ar6000/ar6000/athdrv_linux.h	2009-01-02 00:01:56.000000000 +0100
@@ -0,0 +1,993 @@
+/*
