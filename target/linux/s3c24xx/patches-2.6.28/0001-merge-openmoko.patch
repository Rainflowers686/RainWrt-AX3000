+/*
+ *	Initialise video for linux
+ */
+ 
+static int __init videodev_init(void)
+{
+//	printk(KERN_INFO "FIMC2.0 Built:"__DATE__" "__TIME__"\n%s\n",fimc_version);
+	return 0;
+}
