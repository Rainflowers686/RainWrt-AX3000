-static int be_mbox_db_ready_wait(void __iomem *db)
-{
-	int cnt = 0, wait = 5;
-	u32 ready;
-
-	do {
-		ready = ioread32(db) & MPU_MAILBOX_DB_RDY_MASK;
-		if (ready)
-			break;
-
-		if (cnt > 200000) {
-			printk(KERN_WARNING DRV_NAME
-				": mbox_db poll timed out\n");
-			return -1;
-		}
-
-		if (cnt > 50)
-			wait = 200;
-		cnt += wait;
-		udelay(wait);
-	} while (true);
-
-	return 0;
-}
