+++ linux-2.6.29-rc3.owrt/arch/blackfin/mach-bf533/boards/generic_board.c	2009-05-10 23:48:28.000000000 +0200
@@ -0,0 +1,126 @@
+/*
+ * File:         arch/blackfin/mach-bf533/generic_board.c
