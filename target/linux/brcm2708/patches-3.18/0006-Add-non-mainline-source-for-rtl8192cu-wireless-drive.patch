diff --git a/drivers/net/wireless/rtl8192cu/include/ip.h b/drivers/net/wireless/rtl8192cu/include/ip.h
new file mode 100644
index 0000000..2c3d2f3
--- /dev/null
+++ b/drivers/net/wireless/rtl8192cu/include/ip.h
@@ -0,0 +1,141 @@
+/******************************************************************************
